{
  "name": "@pionxzh/userscripts",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "author": "pionxzh",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "cz": "cz",
    "clean": "rimraf ./dist",
    "release:ci": "cpy packages/**/dist/*.user.js dist --flat",
    "prepare": "husky"
  },
  "devDependencies": {
    "@pionxzh/eslint-config": "2.0.2",
    "@types/node": "^22.10.0",
    "commitizen": "^4.3.2",
    "cpy-cli": "^7.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm exec eslint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@parcel/watcher"]
  }
}
